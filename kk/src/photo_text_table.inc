    // Task 208 (owner, 18 Oct): photo mode (the pause menu's Photo mode and its panel, photo_mode.cpp).
    // Included by launcher_text_table.inc.
    {"Photo mode", "Fotomodus", "Modo foto", "Mode photo", "Modalità foto"},
    {"Colour", "Farbe", "Color", "Couleur", "Colore"},
    {"How wide the camera sees. Lower zooms in, higher shows more around it.",
     "Wie weit die Kamera sieht. Niedriger zoomt heran, höher zeigt mehr von der Umgebung.",
     "Cuánto abarca la cámara. Más bajo acerca la imagen; más alto muestra más alrededor.",
     "L'ouverture de la caméra. Plus bas rapproche l'image, plus haut montre davantage autour.",
     "Quanto vede la telecamera. Più basso ingrandisce, più alto mostra di più intorno."},
    {"Roll", "Neigung", "Inclinación", "Roulis", "Rollio"},
    {"Tilts the camera to the left or right.", "Neigt die Kamera nach links oder rechts.",
     "Inclina la cámara a la izquierda o a la derecha.", "Incline la caméra vers la gauche ou la droite.",
     "Inclina la telecamera a sinistra o a destra."},
    {"Camera speed", "Kamerageschwindigkeit", "Velocidad de la cámara", "Vitesse de la caméra", "Velocità della telecamera"},
    {"How fast the camera moves. Hold the left stick button (Shift) to go faster and the right stick button (Alt) to go slower.",
     "Wie schnell sich die Kamera bewegt. Halte den linken Stick gedrückt (Umschalt), um schneller zu werden, und den rechten Stick (Alt), um langsamer zu werden.",
     "La rapidez con la que se mueve la cámara. Mantén pulsado el stick izquierdo (Mayús) para ir más rápido y el stick derecho (Alt) para ir más despacio.",
     "La vitesse de la caméra. Maintenez le stick gauche enfoncé (Maj) pour aller plus vite et le stick droit (Alt) pour aller plus lentement.",
     "La velocità della telecamera. Tieni premuto lo stick sinistro (Maiusc) per andare più veloce e lo stick destro (Alt) per andare più piano."},
    {"Hide Jack's arms", "Jacks Arme ausblenden", "Ocultar los brazos de Jack", "Masquer les bras de Jack", "Nascondi le braccia di Jack"},
    {"Hides Jack's floating arms while you take pictures. Nothing changes in the game.",
     "Blendet Jacks schwebende Arme aus, während du Fotos machst. Im Spiel ändert sich nichts.",
     "Oculta los brazos flotantes de Jack mientras haces fotos. En el juego no cambia nada.",
     "Masque les bras flottants de Jack pendant que vous prenez des photos. Rien ne change dans le jeu.",
     "Nasconde le braccia fluttuanti di Jack mentre scatti le foto. Nel gioco non cambia nulla."},
    {"Reset camera", "Kamera zurücksetzen", "Restablecer cámara", "Réinitialiser la caméra", "Ripristina telecamera"},
    {"Puts the camera back where photo mode started.", "Setzt die Kamera dorthin zurück, wo der Fotomodus begann.",
     "Devuelve la cámara al lugar donde empezó el modo foto.", "Remet la caméra là où le mode photo a commencé.",
     "Riporta la telecamera dove è iniziata la modalità foto."},
    {"A colour style for the whole picture.", "Ein Farbstil für das ganze Bild.", "Un estilo de color para toda la imagen.",
     "Un style de couleur pour toute l'image.", "Uno stile di colore per tutta l'immagine."},
    {"Black and white", "Schwarzweiß", "Blanco y negro", "Noir et blanc", "Bianco e nero"},
    {"Sepia", "Sepia", "Sepia", "Sépia", "Seppia"},
    {"Warm", "Warm", "Cálido", "Chaud", "Caldo"},
    {"Cool", "Kühl", "Frío", "Froid", "Freddo"},
    {"Green", "Grün", "Verde", "Vert", "Verde"},
    {"Rose", "Rosé", "Rosa", "Rose", "Rosa"},
    {"Look strength", "Stärke des Looks", "Intensidad del aspecto", "Intensité du style", "Intensità dello stile"},
    {"How strongly the look is applied.", "Wie stark der Look angewendet wird.", "Con qué intensidad se aplica el aspecto.",
     "La force avec laquelle le style est appliqué.", "Quanto viene applicato lo stile."},
    {"Exposure", "Belichtung", "Exposición", "Exposition", "Esposizione"},
    {"Brightens or darkens the whole picture, in camera stops.", "Hellt das ganze Bild auf oder dunkelt es ab, in Blendenstufen.",
     "Aclara u oscurece toda la imagen, en pasos de diafragma.", "Éclaircit ou assombrit toute l'image, en diaphragmes.",
     "Schiarisce o scurisce tutta l'immagine, in stop."},
    {"Contrast", "Kontrast", "Contraste", "Contraste", "Contrasto"},
    {"The difference between dark and bright parts.", "Der Unterschied zwischen dunklen und hellen Bereichen.",
     "La diferencia entre las zonas oscuras y las claras.", "L'écart entre les zones sombres et claires.",
     "La differenza tra le parti scure e quelle chiare."},
    {"Saturation", "Sättigung", "Saturación", "Saturation", "Saturazione"},
    {"How strong the colours are. 0% is black and white.", "Wie kräftig die Farben sind. 0 % ist schwarzweiß.",
     "La intensidad de los colores. 0 % es blanco y negro.", "L'intensité des couleurs. 0 % donne du noir et blanc.",
     "Quanto sono intensi i colori. 0% è bianco e nero."},
    {"White balance", "Weißabgleich", "Balance de blancos", "Balance des blancs", "Bilanciamento del bianco"},
    {"Makes the picture cooler (blue) or warmer (orange).", "Macht das Bild kühler (blau) oder wärmer (orange).",
     "Hace la imagen más fría (azul) o más cálida (naranja).", "Rend l'image plus froide (bleue) ou plus chaude (orangée).",
     "Rende l'immagine più fredda (blu) o più calda (arancione)."},
    {"Depth of field", "Tiefenschärfe", "Profundidad de campo", "Profondeur de champ", "Profondità di campo"},
    {"Blurs what is nearer or farther than the focus distance, like a camera lens. 0% is off.",
     "Zeichnet weich, was näher oder weiter weg ist als die Fokusentfernung, wie ein Kameraobjektiv. 0 % ist aus.",
     "Desenfoca lo que está más cerca o más lejos que la distancia de enfoque, como el objetivo de una cámara. 0 % es desactivado.",
     "Floute ce qui est plus proche ou plus loin que la distance de mise au point, comme un objectif. 0 % désactive l'effet.",
     "Sfoca ciò che è più vicino o più lontano della distanza di messa a fuoco, come un obiettivo. 0% è disattivato."},
    {"Focus distance", "Fokusentfernung", "Distancia de enfoque", "Distance de mise au point", "Distanza di messa a fuoco"},
    {"How far from the camera the picture is sharp.", "Wie weit von der Kamera entfernt das Bild scharf ist.",
     "A qué distancia de la cámara la imagen está nítida.", "À quelle distance de la caméra l'image est nette.",
     "A che distanza dalla telecamera l'immagine è nitida."},
    {"Focus range", "Schärfebereich", "Rango de enfoque", "Zone de netteté", "Zona di nitidezza"},
    {"How deep the sharp area is, in front of and behind the focus distance.",
     "Wie tief der scharfe Bereich ist, vor und hinter der Fokusentfernung.",
     "La profundidad de la zona nítida, delante y detrás de la distancia de enfoque.",
     "La profondeur de la zone nette, devant et derrière la distance de mise au point.",
     "Quanto è profonda la zona nitida, davanti e dietro la distanza di messa a fuoco."},
    {"Vignette", "Vignette", "Viñeta", "Vignettage", "Vignettatura"},
    {"Darkens the corners of the picture.", "Dunkelt die Ecken des Bildes ab.", "Oscurece las esquinas de la imagen.",
     "Assombrit les coins de l'image.", "Scurisce gli angoli dell'immagine."},
    {"Film grain", "Filmkorn", "Grano de película", "Grain de film", "Grana della pellicola"},
    {"Adds the fine grain of photographic film.", "Fügt das feine Korn eines Fotofilms hinzu.",
     "Añade el grano fino de la película fotográfica.", "Ajoute le grain fin d'une pellicule photo.",
     "Aggiunge la grana fine della pellicola fotografica."},
    {"Letterbox", "Kinobalken", "Bandas de cine", "Bandes cinéma", "Bande cinema"},
    {"Black bars that give the picture a cinema shape.", "Schwarze Balken, die dem Bild ein Kinoformat geben.",
     "Bandas negras que dan a la imagen formato de cine.", "Des bandes noires qui donnent à l'image un format cinéma.",
     "Bande nere che danno all'immagine un formato cinema."},
    {"Mirror", "Spiegeln", "Reflejar", "Miroir", "Specchio"},
    {"Flips the picture from left to right.", "Spiegelt das Bild von links nach rechts.", "Invierte la imagen de izquierda a derecha.",
     "Retourne l'image de gauche à droite.", "Capovolge l'immagine da sinistra a destra."},
    {"Ink outlines and flat colour bands, as in Settings. Only while photo mode is open.",
     "Tintenkonturen und flache Farbstufen, wie in den Einstellungen. Nur solange der Fotomodus offen ist.",
     "Contornos de tinta y bandas de color planas, como en Ajustes. Solo mientras el modo foto está abierto.",
     "Contours à l'encre et aplats de couleur, comme dans les Paramètres. Seulement tant que le mode photo est ouvert.",
     "Contorni a inchiostro e bande di colore piatte, come nelle Impostazioni. Solo finché la modalità foto è aperta."},
    {"Sharpens the picture, as in Settings. Only while photo mode is open.",
     "Schärft das Bild, wie in den Einstellungen. Nur solange der Fotomodus offen ist.",
     "Aumenta la nitidez de la imagen, como en Ajustes. Solo mientras el modo foto está abierto.",
     "Rend l'image plus nette, comme dans les Paramètres. Seulement tant que le mode photo est ouvert.",
     "Rende l'immagine più nitida, come nelle Impostazioni. Solo finché la modalità foto è aperta."},
    {"Raises or lowers the darkest parts of the picture, as in Settings. Only while photo mode is open.",
     "Hebt oder senkt die dunkelsten Teile des Bildes, wie in den Einstellungen. Nur solange der Fotomodus offen ist.",
     "Aclara u oscurece las zonas más oscuras de la imagen, como en Ajustes. Solo mientras el modo foto está abierto.",
     "Éclaircit ou assombrit les zones les plus sombres de l'image, comme dans les Paramètres. Seulement tant que le mode photo est ouvert.",
     "Schiarisce o scurisce le parti più scure dell'immagine, come nelle Impostazioni. Solo finché la modalità foto è aperta."},
    {"Brightens or darkens the middle tones, as in Settings. Only while photo mode is open.",
     "Hellt die Mitteltöne auf oder dunkelt sie ab, wie in den Einstellungen. Nur solange der Fotomodus offen ist.",
     "Aclara u oscurece los tonos medios, como en Ajustes. Solo mientras el modo foto está abierto.",
     "Éclaircit ou assombrit les tons moyens, comme dans les Paramètres. Seulement tant que le mode photo est ouvert.",
     "Schiarisce o scurisce i toni medi, come nelle Impostazioni. Solo finché la modalità foto è aperta."},
    {"Reset all", "Alles zurücksetzen", "Restablecer todo", "Tout réinitialiser", "Ripristina tutto"},
    {"Puts every photo mode setting back to its default.", "Setzt alle Einstellungen des Fotomodus auf ihre Standardwerte zurück.",
     "Devuelve todos los ajustes del modo foto a sus valores predeterminados.",
     "Remet tous les réglages du mode photo à leur valeur par défaut.",
     "Riporta tutte le impostazioni della modalità foto ai valori predefiniti."},
    {"Show panel", "Leiste zeigen", "Mostrar panel", "Afficher le panneau", "Mostra pannello"},
    {"Hide panel", "Leiste ausblenden", "Ocultar panel", "Masquer le panneau", "Nascondi pannello"},
    {"Take picture", "Foto machen", "Hacer foto", "Prendre une photo", "Scatta foto"},
    {"Move: left stick or W A S D. Look: right stick, or hold the right mouse button. Down and up: triggers, or Ctrl and Space.",
     "Bewegen: linker Stick oder W A S D. Umsehen: rechter Stick oder rechte Maustaste halten. Runter und hoch: Trigger oder Strg und Leertaste.",
     "Moverse: stick izquierdo o W A S D. Mirar: stick derecho o mantener el botón derecho del ratón. Bajar y subir: gatillos o Ctrl y Espacio.",
     "Se déplacer : stick gauche ou W A S D. Regarder : stick droit, ou maintenir le bouton droit de la souris. Descendre et monter : gâchettes, ou Ctrl et Espace.",
     "Muoversi: stick sinistro o W A S D. Guardare: stick destro o tieni premuto il tasto destro del mouse. Giù e su: grilletti, o Ctrl e Spazio."},
    {"Picture saved: {0} (screenshots folder)", "Foto gespeichert: {0} (Ordner screenshots)", "Foto guardada: {0} (carpeta screenshots)",
     "Photo enregistrée : {0} (dossier screenshots)", "Foto salvata: {0} (cartella screenshots)"},
