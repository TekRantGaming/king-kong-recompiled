{
    "version": 6,
    "configurePresets": [
        {
            "name": "user-env",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "${sourceDir}/../tools/rexglue/win-amd64"
            }
        },
        {
            "name": "user-env-linux",
            "hidden": true,
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "${sourceDir}/../tools/rexglue/linux-amd64"
            }
        },
        { "name": "kk-debug",          "inherits": ["win-amd64-debug",          "user-env"] },
        { "name": "kk-release",        "inherits": ["win-amd64-release",        "user-env"] },
        { "name": "kk-relwithdebinfo", "inherits": ["win-amd64-relwithdebinfo", "user-env"] },
        { "name": "kk-linux-release",  "inherits": ["linux-amd64-release",      "user-env-linux"] },
        { "name": "kk-dev",            "inherits": ["kk-release"], "cacheVariables": { "KK_DEV_TOOLS": "ON" } }
    ],
    "buildPresets": [
        { "name": "kk-debug",          "configurePreset": "kk-debug" },
        { "name": "kk-release",        "configurePreset": "kk-release" },
        { "name": "kk-relwithdebinfo", "configurePreset": "kk-relwithdebinfo" },
        { "name": "kk-linux-release",  "configurePreset": "kk-linux-release" },
        { "name": "kk-dev",            "configurePreset": "kk-dev" }
    ]
}
