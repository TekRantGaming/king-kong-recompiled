+void D3D12RenderTargetCache::AoTimestamp(uint32_t category, bool end) {
+  if (!ao_stats_) {
+    return;
+  }
+  uint64_t frame = command_processor_.GetCurrentFrame();
+  uint32_t slot = uint32_t(frame % kAoQuerySlots);
+  if (ao_query_frame_[slot] != frame) {
+    AoReadTimestamps();
+    ao_query_frame_[slot] = frame;
+    ao_query_count_[slot] = 0;
+    ao_query_ao_on_[slot] = REXCVAR_GET(ao_mode) != 0;
+  }
+  if (ao_query_count_[slot] >= kAoQueriesPerSlot) {
+    return;
+  }
+  uint32_t index = slot * kAoQueriesPerSlot + ao_query_count_[slot];
+  ao_query_category_[slot][ao_query_count_[slot]++] = uint8_t(category | (end ? 0x80 : 0));
+  DeferredCommandList& command_list = command_processor_.GetDeferredCommandList();
+  command_list.D3DEndQuery(ao_query_heap_, D3D12_QUERY_TYPE_TIMESTAMP, index);
+  command_list.D3DResolveQueryData(ao_query_heap_, D3D12_QUERY_TYPE_TIMESTAMP, index, 1,
+                                   ao_query_readback_, index * sizeof(uint64_t));
+}
+
+void D3D12RenderTargetCache::AoReadTimestamps() {
+  uint64_t completed = command_processor_.GetCompletedFrame();
+  for (uint32_t slot = 0; slot < kAoQuerySlots; ++slot) {
+    if (!ao_query_count_[slot] || ao_query_frame_[slot] > completed) {
+      continue;
+    }
+    D3D12_RANGE range = {slot * kAoQueriesPerSlot * sizeof(uint64_t),
+                         (slot + 1) * kAoQueriesPerSlot * sizeof(uint64_t)};
+    void* mapping;
+    if (SUCCEEDED(ao_query_readback_->Map(0, &range, &mapping))) {
+      const uint64_t* times = static_cast<const uint64_t*>(mapping) + slot * kAoQueriesPerSlot;
+      double ms[kAoStatCategories] = {};
+      uint64_t start[kAoStatCategories] = {};
+      for (uint32_t i = 0; i < ao_query_count_[slot]; ++i) {
+        uint32_t category = ao_query_category_[slot][i] & 0x7F;
+        if (ao_query_category_[slot][i] & 0x80) {
+          if (start[category] && times[i] >= start[category]) {
+            ms[category] += double(times[i] - start[category]) * 1000.0 / double(ao_timestamp_frequency_);
+          }
+          start[category] = 0;
+        } else {
+          start[category] = times[i];
+        }
+      }
+      D3D12_RANGE written = {0, 0};
+      ao_query_readback_->Unmap(0, &written);
+      uint32_t on = ao_query_ao_on_[slot] ? 1 : 0;
+      for (uint32_t c = 0; c < kAoStatCategories; ++c) {
+        ao_stat_ms_[on][c] += ms[c];
+      }
+      ++ao_stat_frames_[on];
+    }
+    ao_query_count_[slot] = 0;
+  }
+  static const auto start_time = std::chrono::steady_clock::now();
+  double now = std::chrono::duration<double>(std::chrono::steady_clock::now() - start_time).count();
+  if (now - ao_stat_last_ >= 2.0) {
+    ao_stat_last_ = now;
+    for (uint32_t on = 0; on < 2; ++on) {
+      if (!ao_stat_frames_[on]) {
+        continue;
+      }
+      double n = double(ao_stat_frames_[on]);
+      const double* t = ao_stat_ms_[on];
+      REXGPU_WARN(
+          "AO stats ({}): scene copies {:.3f} ms; depth {:.3f}, AO {:.3f}, blur {:.3f}, upsample {:.3f}, "
+          "apply {:.3f} ms a frame over {} frames",
+          on ? "on" : "off", t[0] / n, t[3] / n, t[4] / n, t[5] / n, t[6] / n, t[2] / n,
+          ao_stat_frames_[on]);
+      for (double& value : ao_stat_ms_[on]) {
+        value = 0.0;
+      }
+      ao_stat_frames_[on] = 0;
+    }
+  }
+}
