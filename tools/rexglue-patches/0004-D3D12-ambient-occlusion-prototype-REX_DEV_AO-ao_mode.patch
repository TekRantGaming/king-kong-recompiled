+REXCVAR_DEFINE_INT32(ao_mode, 1, "GPU",
+                     "Ambient occlusion prototype (needs REX_DEV_AO): 0 off, 1 on, 2 AO only");
+REXCVAR_DEFINE_INT32(ao_strength, 1, "GPU", "Ambient occlusion prototype strength set: 1, 2 or 3");
+
+bool D3D12RenderTargetCache::InitAmbientOcclusion() {
+  if (ao_init_tried_) {
+    return ao_available_;
+  }
+  ao_init_tried_ = true;
+  const char* path = std::getenv("REX_DEV_AO");
+  if (!path || !*path) {
+    return false;
+  }
+  std::ifstream file(path, std::ios::binary);
+  if (!file) {
+    REXGPU_WARN("AO: can't read {}", path);
+    return false;
+  }
+  std::string source((std::istreambuf_iterator<char>(file)), std::istreambuf_iterator<char>());
+  // Tuning values (REX_DEV_AO_PARAMS="a,b,c,..."), passed to the shader as is.
+  if (const char* params = std::getenv("REX_DEV_AO_PARAMS"); params && *params) {
+    const char* at = params;
+    for (size_t i = 0; i < std::size(ao_params_) && *at; ++i) {
+      ao_params_[i] = float(std::atof(at));
+      const char* comma = std::strchr(at, ',');
+      if (!comma) {
+        break;
+      }
+      at = comma + 1;
+    }
+  }
+  // REX_DEV_AO_CYCLE=<seconds>: step through the debug views (passed as the
+  // view index) to compare them in one run.
+  if (const char* cycle = std::getenv("REX_DEV_AO_CYCLE"); cycle && *cycle) {
+    ao_cycle_seconds_ = std::atof(cycle);
+  }
+  HMODULE compiler = LoadLibraryW(L"D3DCompiler_47.dll");
+  auto compile = compiler ? reinterpret_cast<pD3DCompile>(GetProcAddress(compiler, "D3DCompile"))
+                          : nullptr;
+  if (!compile) {
+    REXGPU_WARN("AO: D3DCompiler_47.dll not available");
+    return false;
+  }
+  const ui::d3d12::D3D12Provider& provider = command_processor_.GetD3D12Provider();
+  ID3D12Device* device = provider.GetDevice();
+
+  D3D12_ROOT_PARAMETER root_parameters[3];
+  root_parameters[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
+  root_parameters[0].Constants.ShaderRegister = 0;
+  root_parameters[0].Constants.RegisterSpace = 0;
+  root_parameters[0].Constants.Num32BitValues = 16;
+  root_parameters[0].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+  D3D12_DESCRIPTOR_RANGE ranges[2];
+  for (uint32_t i = 0; i < 2; ++i) {
+    ranges[i].RangeType = D3D12_DESCRIPTOR_RANGE_TYPE_UAV;
+    ranges[i].NumDescriptors = 1;
+    ranges[i].BaseShaderRegister = i;
+    ranges[i].RegisterSpace = 0;
+    ranges[i].OffsetInDescriptorsFromTableStart = 0;
+    root_parameters[1 + i].ParameterType = D3D12_ROOT_PARAMETER_TYPE_DESCRIPTOR_TABLE;
+    root_parameters[1 + i].DescriptorTable.NumDescriptorRanges = 1;
+    root_parameters[1 + i].DescriptorTable.pDescriptorRanges = &ranges[i];
+    root_parameters[1 + i].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+  }
+  D3D12_ROOT_SIGNATURE_DESC root_signature_desc = {};
+  root_signature_desc.NumParameters = UINT(std::size(root_parameters));
+  root_signature_desc.pParameters = root_parameters;
+  ao_root_signature_ = ui::d3d12::util::CreateRootSignature(provider, root_signature_desc);
+  if (!ao_root_signature_) {
+    REXGPU_WARN("AO: failed to create the root signature");
+    return false;
+  }
+  auto build = [&](const char* entry) -> ID3D12PipelineState* {
+    ID3DBlob* code = nullptr;
+    ID3DBlob* errors = nullptr;
+    HRESULT result = compile(source.data(), source.size(), path, nullptr, nullptr, entry, "cs_5_0",
+                             D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &code, &errors);
+    if (errors) {
+      REXGPU_WARN("AO: {}: {}", entry, static_cast<const char*>(errors->GetBufferPointer()));
+      errors->Release();
+    }
+    if (FAILED(result) || !code) {
+      return nullptr;
+    }
+    ID3D12PipelineState* pipeline = ui::d3d12::util::CreateComputePipeline(
+        device, code->GetBufferPointer(), code->GetBufferSize(), ao_root_signature_);
+    code->Release();
+    return pipeline;
+  };
+  ao_pipeline_compute_ = build("ComputeAO");
+  ao_pipeline_apply_ = build("ApplyAO");
+  if (!ao_pipeline_compute_ || !ao_pipeline_apply_) {
+    REXGPU_WARN("AO: failed to build the pipelines");
+    return false;
+  }
+  ao_available_ = true;
+  REXGPU_WARN("AO: prototype enabled from {} (params {} {} {} {} {} {} {} {})", path, ao_params_[0],
+              ao_params_[1], ao_params_[2], ao_params_[3], ao_params_[4], ao_params_[5],
+              ao_params_[6], ao_params_[7]);
+  return true;
+}
+
+void D3D12RenderTargetCache::ApplyAmbientOcclusion(uint32_t color_base_tiles,
+                                                   uint32_t depth_base_tiles, uint32_t pitch_tiles,
+                                                   uint32_t width, uint32_t height) {
+  const ui::d3d12::D3D12Provider& provider = command_processor_.GetD3D12Provider();
+  ID3D12Device* device = provider.GetDevice();
+  uint32_t buffer_size = width * height * sizeof(float);
+  if (!ao_buffer_) {
+    D3D12_RESOURCE_DESC desc;
+    ui::d3d12::util::FillBufferResourceDesc(desc, buffer_size,
+                                            D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS);
+    if (FAILED(device->CreateCommittedResource(&ui::d3d12::util::kHeapPropertiesDefault,
+                                               provider.GetHeapFlagCreateNotZeroed(), &desc,
+                                               D3D12_RESOURCE_STATE_UNORDERED_ACCESS, nullptr,
+                                               IID_PPV_ARGS(&ao_buffer_)))) {
+      REXGPU_WARN("AO: failed to create the {} byte buffer", buffer_size);
+      ao_available_ = false;
+      return;
+    }
+    ao_buffer_size_ = buffer_size;
+  }
+  if (buffer_size > ao_buffer_size_) {
+    return;
+  }
+  ui::d3d12::util::DescriptorCpuGpuHandlePair descriptors[2];
+  if (!command_processor_.RequestOneUseSingleViewDescriptors(2, descriptors)) {
+    return;
+  }
+  WriteEdramRawUAVDescriptor(descriptors[0].first);
+  D3D12_UNORDERED_ACCESS_VIEW_DESC uav_desc = {};
+  uav_desc.Format = DXGI_FORMAT_R32_TYPELESS;
+  uav_desc.ViewDimension = D3D12_UAV_DIMENSION_BUFFER;
+  uav_desc.Buffer.NumElements = ao_buffer_size_ / 4;
+  uav_desc.Buffer.Flags = D3D12_BUFFER_UAV_FLAG_RAW;
+  device->CreateUnorderedAccessView(ao_buffer_, nullptr, &uav_desc, descriptors[1].first);
+
+  struct {
+    uint32_t color_base, depth_base, pitch_tiles, width;
+    uint32_t height, tile_width, tile_height, view;
+    float params[8];
+  } constants;
+  constants.color_base = color_base_tiles;
+  constants.depth_base = depth_base_tiles;
+  constants.pitch_tiles = pitch_tiles;
+  constants.width = width;
+  constants.height = height;
+  constants.tile_width = xenos::kEdramTileWidthSamples * draw_resolution_scale_x();
+  constants.tile_height = xenos::kEdramTileHeightSamples * draw_resolution_scale_y();
+  // Views: 0 off, 1 depth, 2-4 AO only with set 1-3, 5-7 applied with set 1-3.
+  uint32_t set = uint32_t(std::clamp(REXCVAR_GET(ao_strength), 1, 3) - 1);
+  constants.view = REXCVAR_GET(ao_mode) == 2 ? 2 + set : 5 + set;
+  if (ao_cycle_seconds_ > 0.0) {
+    static const auto start = std::chrono::steady_clock::now();
+    double t = std::chrono::duration<double>(std::chrono::steady_clock::now() - start).count();
+    constants.view = uint32_t(t / ao_cycle_seconds_) % 8;
+  }
+  std::memcpy(constants.params, ao_params_, sizeof(constants.params));
+  ++ao_frame_;
+
+  TransitionEdramBuffer(D3D12_RESOURCE_STATE_UNORDERED_ACCESS);
+  command_processor_.SubmitBarriers();
+  DeferredCommandList& command_list = command_processor_.GetDeferredCommandList();
+  command_list.D3DSetComputeRootSignature(ao_root_signature_);
+  command_list.D3DSetComputeRoot32BitConstants(0, sizeof(constants) / sizeof(uint32_t), &constants,
+                                               0);
+  command_list.D3DSetComputeRootDescriptorTable(1, descriptors[0].second);
+  command_list.D3DSetComputeRootDescriptorTable(2, descriptors[1].second);
+  // The AO is computed once a frame and applied to each scene copy.
+  if (ao_computed_frame_ != command_processor_.GetCurrentFrame()) {
+    ao_computed_frame_ = command_processor_.GetCurrentFrame();
+    command_processor_.SetExternalPipeline(ao_pipeline_compute_);
+    command_list.D3DDispatch((width + 7) / 8, (height + 7) / 8, 1);
+    command_processor_.PushUAVBarrier(ao_buffer_);
+    command_processor_.SubmitBarriers();
+  }
+  command_processor_.SetExternalPipeline(ao_pipeline_apply_);
+  command_list.D3DDispatch((width + 7) / 8, (height + 7) / 8, 1);
+  command_processor_.PushUAVBarrier(edram_buffer_);
+  command_processor_.SubmitBarriers();
+  MarkEdramBufferModified();
+}
