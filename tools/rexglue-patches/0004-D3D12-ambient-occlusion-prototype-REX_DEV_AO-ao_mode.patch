 bool D3D12RenderTargetCache::Resolve(const memory::Memory& memory, D3D12SharedMemory& shared_memory,
                                      D3D12TextureCache& texture_cache,
                                      uint32_t& written_address_out, uint32_t& written_length_out) {
@@ -1180,6 +1374,42 @@ bool D3D12RenderTargetCache::Resolve(const memory::Memory& memory, D3D12SharedMe
     return true;
   }
 
+  // Ambient occlusion prototype: a full-screen 32bpp depth copy marks the
+  // scene depth as complete. Every full-screen 8888 color copy later in that
+  // frame is the scene going to an effect (such as water refraction) or to
+  // post-processing. With host render targets each copy is dumped afresh from
+  // the render target, so each gets the AO once; with ROV the EDRAM buffer is
+  // the render target itself, so only the first one.
+  bool apply_ao = false;
+  uint32_t ao_color_base = 0, ao_pitch_tiles = 0;
+  if (resolve_info.copy_dest_extent_length && InitAmbientOcclusion() &&
+      (REXCVAR_GET(ao_mode) != 0 || ao_cycle_seconds_ > 0.0)) {
+    bool copying_depth = resolve_info.IsCopyingDepth();
+    const draw_util::ResolveEdramInfo& edram_info =
+        copying_depth ? resolve_info.depth_edram_info : resolve_info.color_edram_info;
+    bool full_screen = resolve_info.coordinate_info.width_div_8 * 8 >= 1280 &&
+                       resolve_info.height_div_8 * 8 >= 720 &&
+                       !resolve_info.coordinate_info.edram_offset_x_div_8 &&
+                       !resolve_info.coordinate_info.edram_offset_y_div_8 &&
+                       edram_info.msaa_samples == xenos::MsaaSamples::k1X &&
+                       !edram_info.format_is_64bpp;
+    uint64_t frame = command_processor_.GetCurrentFrame();
+    if (copying_depth) {
+      ao_depth_copied_ = full_screen && edram_info.format == uint32_t(xenos::DepthRenderTargetFormat::kD24S8);
+      ao_depth_base_tiles_ = edram_info.base_tiles;
+      ao_depth_frame_ = frame;
+      ao_applied_this_frame_ = false;
+    } else if (ao_depth_copied_ && ao_depth_frame_ == frame && full_screen &&
+               (GetPath() == Path::kHostRenderTargets || !ao_applied_this_frame_) &&
+               (edram_info.format == uint32_t(xenos::ColorRenderTargetFormat::k_8_8_8_8) ||
+                edram_info.format == uint32_t(xenos::ColorRenderTargetFormat::k_8_8_8_8_GAMMA))) {
+      apply_ao = true;
+      ao_applied_this_frame_ = true;
+      ao_color_base = edram_info.base_tiles;
+      ao_pitch_tiles = edram_info.pitch_tiles;
+    }
+  }
+
   DeferredCommandList& command_list = command_processor_.GetDeferredCommandList();
 
   // Copying.
@@ -1196,7 +1426,7 @@ bool D3D12RenderTargetCache::Resolve(const memory::Memory& memory, D3D12SharedMe
           draw_util::resolve_copy_shader_info[size_t(copy_shader)];
       bool direct_resolved = false;
       if (GetPath() == Path::kHostRenderTargets) {
-        if (REXCVAR_GET(direct_host_resolve)) {
+        if (REXCVAR_GET(direct_host_resolve) && !apply_ao) {
           direct_resolved =
               TryResolveCopyDirectly(resolve_info, copy_shader, draw_resolution_scaled);
           if (direct_resolved) {
@@ -1217,8 +1447,18 @@ bool D3D12RenderTargetCache::Resolve(const memory::Memory& memory, D3D12SharedMe
             REXGPU_ERROR("D3D12RenderTargetCache: Failed to dump host render targets for resolve");
             return false;
           }
+          // The ambient occlusion pass also reads the scene depth.
+          if (apply_ao &&
+              !DumpRenderTargets(ao_depth_base_tiles_, dump_row_length_used, dump_rows, dump_pitch)) {
+            apply_ao = false;
+          }
         }
       }
+      if (apply_ao) {
+        ApplyAmbientOcclusion(ao_color_base, ao_depth_base_tiles_, ao_pitch_tiles,
+                              resolve_info.coordinate_info.width_div_8 * 8 * draw_resolution_scale_x(),
+                              resolve_info.height_div_8 * 8 * draw_resolution_scale_y());
+      }
 
       // Make sure there is memory to write to.
       bool copy_dest_committed;
