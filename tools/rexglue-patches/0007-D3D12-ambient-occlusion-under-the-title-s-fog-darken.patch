+void D3D12RenderTargetCache::NoteAoFogConstants(const float* constants, uint64_t frame) {
+  std::memcpy(ao_fog_constants_, constants, sizeof(ao_fog_constants_));
+  ao_fog_frame_ = frame;
+  // Testing: REX_DEV_AO_TRACE also logs the fog constants every 300 frames.
