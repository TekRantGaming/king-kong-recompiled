   uint view;  // 0 off, 1 depth, 2-4 AO only (sets 1-3), 5-7 applied (sets 1-3)
   float4 p0;  // w: fade distance (near-plane units)
   float4 p1;  // x: tan(horizontal half FOV), w: view stamp
+  // The game's fog pass this frame: its g_vFogNormalizing (xyz), and its
+  // g_vFogParams near over distance, density and inverse distance; w is 1 if
+  // there was a fog pass.
+  float4 fog_normalizing;
+  float4 fog_params;
+  float4 fog_color;
 };
 
 RWByteAddressBuffer edram : register(u0);
 RWTexture2D<float> depth_half : register(u1);  // linear depth, half resolution
 RWTexture2D<float> ao_a : register(u2);        // half resolution
 RWTexture2D<float> ao_b : register(u3);        // half resolution
-RWTexture2D<float> ao_full : register(u4);     // full resolution
+// Full resolution: x multiplies the scene color, y is how much fog color to
+// add back, so only the scene under the game's fog is darkened.
+RWTexture2D<float2> ao_full : register(u4);
 
 // Fits 16-bit floats; anything this far is past the distance fade anyway.
 static const float kSky = 60000.0;
@@ -44,12 +52,33 @@ uint EdramAddress(uint2 p, uint base, bool is_depth) {
   return (tile_index * tile_width * tile_height + in_tile.y * tile_width + in_tile.x) * 4u;
 }
 
+float RawDepthAt(uint2 p) {
+  return float(edram.Load(EdramAddress(p, depth_base, true)) >> 8) * (1.0 / 16777215.0);
+}
+
 // Distance from the camera in units of the near plane (assuming the far plane
 // is much further than the near one); kSky for the sky.
-float LinearDepthAt(uint2 p) {
-  float z = float(edram.Load(EdramAddress(p, depth_base, true)) >> 8) * (1.0 / 16777215.0);
+float LinearDepth(float z) {
   return z >= 0.99999 ? kSky : min(1.0 / max(1.0 - z, 1.0 / 65536.0), 50000.0);
 }
+float LinearDepthAt(uint2 p) { return LinearDepth(RawDepthAt(p)); }
+
+// How much of the game's own fog covers a pixel at this depth, the same way
+// its fog pass works it out (without its softening for looking up or down,
+// which only ever lowers the fog). The fog is drawn before the scene copy the
+// AO goes into: a pixel there is scene * (1 - fog) + fog color * fog, and only
+// the scene part should be darkened.
+float FogAmount(float z) {
+  if (fog_params.w <= 0.0) {
+    return 0.0;
+  }
+  float inverse_depth = fog_normalizing.x * min(z, fog_normalizing.z) - fog_normalizing.y;
+  if (inverse_depth <= 0.0) {
+    return 1.0;
+  }
+  float fog = saturate((1.0 / inverse_depth) * fog_params.z - fog_params.x);
+  return saturate(fog * fog_params.y);
+}
 
 uint2 HalfSize() { return uint2(width, height) >> 1; }
 float TanX() { return p1.x > 0.0 ? p1.x : 0.684; }
@@ -161,8 +190,10 @@ void Upsample(uint3 id : SV_DispatchThreadID) {
   if (id.x >= width || id.y >= height) {
     return;
   }
-  float zc = LinearDepthAt(id.xy);
+  float z = RawDepthAt(id.xy);
+  float zc = LinearDepth(z);
   float ao = 1.0;
+  float fog = 0.0;
   if (zc < kSky) {
     uint2 size = HalfSize();
     float2 hp = (float2(id.xy) + 0.5) * 0.5 - 0.5;
@@ -181,10 +212,13 @@ void Upsample(uint3 id : SV_DispatchThreadID) {
     ao = weight > 0.0 ? total / weight : 1.0;
     float fade_distance = p0.w > 0.0 ? p0.w : 2000.0;
     ao = lerp(1.0, ao, saturate(1.0 - zc / fade_distance));
+    fog = FogAmount(z);
   }
   // Squared: the look first tested had the AO applied twice by mistake (to
   // the scene and again to the final image), and strength 1 was liked.
-  ao_full[id.xy] = ao * ao;
+  ao *= ao;
+  // color * ao + fog color * fog * (1 - ao) darkens only the scene part.
+  ao_full[id.xy] = float2(ao, fog * (1.0 - ao));
 }
 
 [numthreads(8, 8, 1)]
@@ -194,8 +228,10 @@ void ApplyAO(uint3 id : SV_DispatchThreadID) {
   }
   uint address = EdramAddress(id.xy, color_base, false);
   uint color = edram.Load(address);
+  float2 ao_fog = ao_full[id.xy];
   if (view >= 2u && view <= 4u) {
-    uint g = uint(saturate(ao_full[id.xy]) * 255.0 + 0.5);
+    // The darkening as it ends up on this pixel.
+    uint g = uint(saturate(ao_fog.x + ao_fog.y) * 255.0 + 0.5);
     color = (color & 0xFF000000u) | (g << 16) | (g << 8) | g;
   } else if (view == 1u) {
     float zc = LinearDepthAt(id.xy);
@@ -205,9 +241,9 @@ void ApplyAO(uint3 id : SV_DispatchThreadID) {
       color = (color & 0xFF000000u) | 0xFFu;
     }
   } else if (view != 0u) {
-    float ao = ao_full[id.xy];
-    float3 c = float3(color & 0xFFu, (color >> 8) & 0xFFu, (color >> 16) & 0xFFu) * ao;
-    uint3 ci = uint3(c + 0.5);
+    float3 c = float3(color & 0xFFu, (color >> 8) & 0xFFu, (color >> 16) & 0xFFu) * ao_fog.x +
+               saturate(fog_color.rgb) * (255.0 * ao_fog.y);
+    uint3 ci = uint3(min(c + 0.5, 255.0));
     color = (color & 0xFF000000u) | (ci.z << 16) | (ci.y << 8) | ci.x;
   }
   // View number stamp for test captures: view + 1 small squares, top right.
