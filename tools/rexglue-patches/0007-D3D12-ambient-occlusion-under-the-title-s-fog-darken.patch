+  if (trace && frame % 300 == 0) {
+    const float* c = constants;
+    REXGPU_WARN("AO fog constants: c0 {} {} {} {} | c1 {} {} {} {} | c2 {} {} {} {} | c3 {} {} {} {}", c[0], c[1],
+                c[2], c[3], c[4], c[5], c[6], c[7], c[8], c[9], c[10], c[11], c[12], c[13], c[14], c[15]);
+  }
+}
