+#if defined(REX_HAS_NIS)
+  if (config.GetEffect() == GuestOutputPaintConfig::Effect::kNis) {
+    // NVIDIA Image Scaling. NVScaler upscales by 1x to 2x along each axis, so,
+    // like EASU, it's run several times for bigger factors (the implementation
+    // sharpens only in the last pass). Without upscaling (native or
+    // supersampled), NVSharpen at the source size. Both are compute shaders
+    // writing to intermediate images, so a bilinear pass always follows (1:1,
+    // or downscaling a supersampled image).
+    std::pair<uint32_t, uint32_t> nis_last_size(properties.frontbuffer_width,
+                                                properties.frontbuffer_height);
+    uint32_t nis_pass_count = 0;
+    while (nis_pass_count < GuestOutputPaintConfig::kFsrMaxUpscalingPassesMax &&
+           (nis_last_size.first < output_width_clamped ||
+            nis_last_size.second < output_height_clamped)) {
+      nis_last_size.first = std::max(
+          nis_last_size.first, std::min(nis_last_size.first * uint32_t(2), output_width_clamped));
+      nis_last_size.second =
+          std::max(nis_last_size.second,
+                   std::min(nis_last_size.second * uint32_t(2), output_height_clamped));
+      assert_true(flow.effect_count < flow.effects.size());
+      flow.effect_output_sizes[flow.effect_count] = nis_last_size;
+      flow.effects[flow.effect_count++] = GuestOutputPaintEffect::kNisScale;
+      ++nis_pass_count;
+    }
+    if (!nis_pass_count) {
+      nis_last_size.first = std::min(nis_last_size.first, max_rt_width);
+      nis_last_size.second = std::min(nis_last_size.second, max_rt_height);
+      assert_true(flow.effect_count < flow.effects.size());
+      flow.effect_output_sizes[flow.effect_count] = nis_last_size;
+      flow.effects[flow.effect_count++] = GuestOutputPaintEffect::kNisSharpen;
+    }
+    assert_true(flow.effect_count < flow.effects.size());
+    flow.effect_output_sizes[flow.effect_count] = std::make_pair(output_width, output_height);
+    flow.effects[flow.effect_count++] = GuestOutputPaintEffect::kBilinear;
+  }
+#endif  // defined(REX_HAS_NIS)
