+#if defined(NIS_HLSL)
+#undef NIS_HLSL
+#endif
+#define NIS_HLSL 1
+#endif
+#if NIS_HLSL && NIS_GLSL
+#undef NIS_GLSL
+#define NIS_GLSL 0
+#endif
+
+// Half precision
+#ifndef NIS_USE_HALF_PRECISION
+#define NIS_USE_HALF_PRECISION 0
+#endif
