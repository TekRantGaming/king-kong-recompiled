   shader_object_.resize(shader_object_.size() + sizeof(dxbc::RdefHeader) / sizeof(uint32_t));
-  // Generator name.
-  dxbc::AppendAlignedString(shader_object_, "Xenia");
+  // Generator name. For testing only: REX_DEV_SHADER_SALT adds text to it, so
+  // the driver's own shader cache sees every shader as new (to measure the
+  // first-time cost of creating pipelines); it changes nothing else.
+  static const std::string generator_name = [] {
+    const char* salt = std::getenv("REX_DEV_SHADER_SALT");
+    return salt && *salt ? std::string("Xenia ") + salt : std::string("Xenia");
+  }();
+  dxbc::AppendAlignedString(shader_object_, generator_name.c_str());
 
