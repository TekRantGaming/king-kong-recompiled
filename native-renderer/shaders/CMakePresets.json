{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        { "name": "release", "inherits": "base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
        { "name": "debug", "inherits": "base", "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
        {
            "name": "release-spirv",
            "inherits": "release",
            "cacheVariables": {
                "KKSHADERS_GLSLANG_DIR": "C:/rexsrc/thirdparty/glslang",
                "KKSHADERS_SPIRV_TOOLS_DIR": "C:/rexsrc/thirdparty/spirv-tools",
                "KKSHADERS_SPIRV_HEADERS_DIR": "C:/rexsrc/thirdparty/spirv-headers"
            }
        }
    ],
    "buildPresets": [
        { "name": "release", "configurePreset": "release" },
        { "name": "debug", "configurePreset": "debug" },
        { "name": "release-spirv", "configurePreset": "release-spirv" }
    ]
}
