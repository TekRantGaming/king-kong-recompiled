From 95647976e45bce3bfe51eda3cbf96d8839effe5f Mon Sep 17 00:00:00 2001
From: TekRantGaming <craigferels896@gmail.com>
Date: Sat, 10 Oct 2026 03:51:24 +0000
Subject: [PATCH] Vulkan: enable timelineSemaphore and synchronization2 when
 supported

Libraries created on the provider's device (the native renderer's NVRHI)
need both: NVRHI's queues use timeline semaphores and its barriers use
vkCmdPipelineBarrier2. Enabling them changes nothing for the SDK's own
code. Properties gains the two flags and device.h defines
REX_UI_VULKAN_DEVICE_HAS_SYNC_FEATURES so a plugin can check at build time.
---
 include/rex/ui/vulkan/device.h  | 14 ++++++++++++++
 src/ui/vulkan/vulkan_device.cpp |  2 ++
 2 files changed, 16 insertions(+)

diff --git a/include/rex/ui/vulkan/device.h b/include/rex/ui/vulkan/device.h
index 947817f..714c107 100644
--- a/include/rex/ui/vulkan/device.h
+++ b/include/rex/ui/vulkan/device.h
@@ -20,6 +20,11 @@ namespace rex {
 namespace ui {
 namespace vulkan {
 
+// Properties::timelineSemaphore and Properties::synchronization2 exist (and
+// are enabled when supported), for libraries such as NVRHI created on this
+// device.
+#define REX_UI_VULKAN_DEVICE_HAS_SYNC_FEATURES 1
+
 class VulkanDevice {
  public:
   static std::unique_ptr<VulkanDevice> CreateIfSupported(const VulkanInstance* vulkan_instance,
@@ -132,6 +137,15 @@ class VulkanDevice {
     bool separateStencilMaskRef = false;
     bool shaderSampleRateInterpolationFunctions = false;
 
+    // Vulkan 1.2 core, enabled whenever supported (not used by the SDK itself,
+    // but by libraries created on this device, such as NVRHI).
+
+    bool timelineSemaphore = false;
+
+    // Vulkan 1.3 core, enabled whenever supported (as above).
+
+    bool synchronization2 = false;
+
     // VK_KHR_driver_properties (#197, promoted to 1.2)
 
     VkDriverId driverID = VkDriverId(0);
diff --git a/src/ui/vulkan/vulkan_device.cpp b/src/ui/vulkan/vulkan_device.cpp
index 8197bb4..3b5c7a1 100644
--- a/src/ui/vulkan/vulkan_device.cpp
+++ b/src/ui/vulkan/vulkan_device.cpp
@@ -646,6 +646,7 @@ std::unique_ptr<VulkanDevice> VulkanDevice::CreateIfSupported(
   }
 
   if (properties.apiVersion >= VK_MAKE_API_VERSION(0, 1, 2, 0)) {
+    XE_UI_VULKAN_FEATURE_2(features_1_2, timelineSemaphore);
     if (with_gpu_emulation) {
       XE_UI_VULKAN_FEATURE_2(features_1_2, samplerMirrorClampToEdge);
       XE_UI_VULKAN_FEATURE_2(features_1_2, uniformBufferStandardLayout);
@@ -658,6 +659,7 @@ std::unique_ptr<VulkanDevice> VulkanDevice::CreateIfSupported(
   }
 
   if (properties.apiVersion >= VK_MAKE_API_VERSION(0, 1, 3, 0)) {
+    XE_UI_VULKAN_FEATURE_2(features_1_3, synchronization2);
     if (with_gpu_emulation) {
       XE_UI_VULKAN_FEATURE_2(features_1_3, shaderDemoteToHelperInvocation);
       XE_UI_VULKAN_FEATURE_2(features_1_3, dynamicRendering);
-- 
