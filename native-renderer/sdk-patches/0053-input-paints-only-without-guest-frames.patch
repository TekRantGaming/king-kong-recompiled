+namespace {
+// When the guest last sent a frame (steady clock, ms); see GuestOutputRefreshedRecently.
+std::atomic<int64_t> g_last_guest_refresh_ms{-1000000};
+int64_t SteadyMs() {
+  return std::chrono::duration_cast<std::chrono::milliseconds>(
+             std::chrono::steady_clock::now().time_since_epoch())
+      .count();
+}
+}  // namespace
+
+// Window input asks for a UI paint so a dialog answers at once even while nothing else paints. While the guest
+// sends frames, every frame paints the UI anyway, and those extra paints only present the last frame again: a
+// moving mouse (hundreds of events a second) then pushes presents far past the game's frame rate cap and breaks
+// the frame pacing (King Kong, issue 58). Window input skips its paint while this says the guest is sending frames.
+bool GuestOutputRefreshedRecently() {
+  return SteadyMs() - g_last_guest_refresh_ms.load(std::memory_order_relaxed) < 250;
+}
