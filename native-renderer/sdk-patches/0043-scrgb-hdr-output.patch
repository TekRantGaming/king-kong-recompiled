+// SDR post-processing is complete before this pass. Linear BT.709 scRGB, 1 = 80 nits.
+// Preserve black and midtones. A bounded shoulder expands only highlights; RGB
+// is scaled together to preserve hue. Neutral whites (including guest subtitles)
+// stay at paper white, avoiding a peak-bright white HUD or broad white fog.
+struct HdrParameters {
+  float paper;
+  float peak;
+  float padding0;
+  float padding1;
+};
+#ifdef VULKAN
+[[vk::push_constant]]
+#endif
+ConstantBuffer<HdrParameters> hdr_values : register(b0);
+#define paper hdr_values.paper
+#define peak hdr_values.peak
+#ifdef VULKAN
+[[vk::binding(0, 0)]]
+#endif
+Texture2D<float4> game_image : register(t0);
+#ifdef VULKAN
+[[vk::binding(1, 0)]]
+#endif
+Texture2D<float4> ui_image : register(t1);
+
+float3 DecodeSrgb(float3 c) {
+  c = saturate(c);
+  return float3(c.r <= 0.04045 ? c.r / 12.92 : pow((c.r + 0.055) / 1.055, 2.4),
+                c.g <= 0.04045 ? c.g / 12.92 : pow((c.g + 0.055) / 1.055, 2.4),
+                c.b <= 0.04045 ? c.b / 12.92 : pow((c.b + 0.055) / 1.055, 2.4));
+}
+float3 MapGame(float3 gamma) {
+  float3 c = DecodeSrgb(gamma);
+  float high = max(c.r, max(c.g, c.b));
+  float low = min(c.r, min(c.g, c.b));
+  float y = dot(c, float3(0.2126, 0.7152, 0.0722));
+  float shoulder = smoothstep(0.5, 1.0, y);
+  // Inverse shoulder of a Reinhard curve, gated to bright chromatic pixels.
+  // SDR cannot recover the original radiance or separate the baked-in guest HUD.
+  float chroma = smoothstep(0.0, 0.25, high - low);
+  float gain = rcp(1.0 - (1.0 - paper / max(peak, paper)) * shoulder * chroma);
+  float3 mapped = c * paper * gain;
+  return mapped * min(1.0, peak / max(max(mapped.r, max(mapped.g, mapped.b)), 1e-6));
+}
+float4 vsmain(uint id : SV_VertexID) : SV_Position {
+  float2 uv = float2((id << 1) & 2, id & 2);
+#ifdef VULKAN
+  return float4(uv * 2.0 - 1.0, 0.0, 1.0);
+#else
+  return float4(uv * float2(2.0, -2.0) + float2(-1.0, 1.0), 0.0, 1.0);
+#endif
+}
+float4 psmain(float4 position : SV_Position) : SV_Target {
+  int3 p = int3(position.xy, 0);
+  float3 scene = MapGame(game_image.Load(p).rgb);
+  // UI was alpha blended onto transparent SDR: unpremultiply before decoding,
+  // then composite in linear light at paper white.
+  float4 ui = ui_image.Load(p);
+  float a = saturate(ui.a);
+  float3 overlay = a > 0 ? DecodeSrgb(ui.rgb / max(a, 1e-6)) * a * paper : 0;
+  return float4(scene * (1 - a) + overlay, 1);
+}
