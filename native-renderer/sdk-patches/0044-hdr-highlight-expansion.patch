+// Task 262: the game renders only 8-bit 0..1 targets (frame logs: k_8_8_8_8 colour, k_32_FLOAT depth copies),
+// so there is no scene radiance above 1.0 to keep. Instead: everything whose level is at or below the knee is
+// exactly c * paper (task 127's neutral mapping); above it the gain rises smoothly (C1 at the knee, in log2)
+// to peak / paper at SDR white, scaled by the expansion amount. RGB is scaled together (hue kept). The level is
+// luminance lifted halfway toward the largest component, so saturated fire / coloured lights also expand.
+// One code value of triangular dither in the expanded range breaks up banding from the 8-bit source.
+float2 Hash2(uint2 p) {
+  uint h = p.x * 0x8da6b343u ^ p.y * 0xd8163841u;
+  h ^= h >> 15; h *= 0x2c1b3c6du; h ^= h >> 12; h *= 0x297a2d39u; h ^= h >> 15;
+  return float2(h & 0xffffu, h >> 16) / 65535.0;
+}
+float Level(float3 c) {
+  return lerp(dot(c, float3(0.2126, 0.7152, 0.0722)), max(c.r, max(c.g, c.b)), 0.5);
+}
+// Large bright areas (sky, white fades, bright sea) stay at or below the display's full-frame brightness: the
+// ceiling moves from peak toward full_frame as the surroundings (12 taps on rings at 3% and 8% of the picture
+// height) get brighter, so a sun or a spark reaches peak but a bright sky does not make the screen dim itself.
+float Surroundings(int2 p) {
+  uint w, h;
+  game_image.GetDimensions(w, h);
+  float sum = 0;
+  [unroll] for (int i = 0; i < 12; ++i) {
+    float a = i * 0.5235988 + (i & 1) * 0.2617994;
+    float r = (i & 1 ? 0.08 : 0.03) * h;
+    int2 q = clamp(p + int2(float2(cos(a), sin(a)) * r), int2(0, 0), int2(w - 1, h - 1));
+    sum += Level(DecodeSrgb(game_image.Load(int3(q, 0)).rgb));
+  }
+  return sum / 12;
+}
+float3 MapHighlights(float3 gamma, uint2 p) {
+  float3 c = DecodeSrgb(gamma);
+  float3 mapped = c * paper;
+  if (Level(c) > knee) {
+    float2 n = Hash2(p);
+    float top = max(gamma.r, max(gamma.g, gamma.b));
+    c = DecodeSrgb(gamma + (n.x + n.y - 1.0) / 255.0 * (1.0 - smoothstep(0.985, 1.0, top)));
+    float ceiling = full_frame < peak ? lerp(peak, full_frame, smoothstep(knee, 1.0, Surroundings(int2(p)))) : peak;
+    float t = saturate(log2(max(Level(c), 1e-6) / knee) / -log2(knee));
+    float boost = 1.0 + highlights * (ceiling / paper - 1.0);
+    mapped = c * paper * exp2(log2(boost) * t * t);
