--- a/src/ui/vulkan/vulkan_presenter.cpp
+++ b/src/ui/vulkan/vulkan_presenter.cpp
@@ -1883,6 +1883,16 @@
             if (swapchain_effect_pipeline.swapchain_pipeline == VK_NULL_HANDLE) {
               guest_output_flow.effect_count = 0;
             }
+#if !REX_PLATFORM_WIN32
+            // Remember the render pass format the pipeline was made for. Without this the
+            // format check above never matched, so every paint waited on the CPU for the
+            // previous paint's GPU work and made the final pipeline again, halving the host
+            // present rate under GPU load (task 083, Linux). Linux-only for now: Windows
+            // keeps its exact Beta 4 behaviour until this is tested there.
+            else {
+              swapchain_effect_pipeline.swapchain_format = paint_context_.swapchain_render_pass_format;
+            }
+#endif
           }
         }
       }
